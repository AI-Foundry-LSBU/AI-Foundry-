PORT=3000
DATABASE_URL=postgresql://ai_foundry:local_demo_password@127.0.0.1:5432/ai_foundry
# Integration tests create and remove a uniquely named schema in this database.
TEST_DATABASE_URL=postgresql://ai_foundry:local_demo_password@127.0.0.1:5432/ai_foundry
# Run npm run auth:configure to fill these in your private .env automatically.
SESSION_SECRET=
DEMO_STAFF_PASSWORD=
DEMO_STAFF2_PASSWORD=
DEMO_MANAGER_PASSWORD=
DEMO_ENGINEER_PASSWORD=
# US10: private developer experiments only; disabled when NODE_ENV=production.
# Use a Google AI Studio Free-tier project without linked billing.
# Keys are server-only. The application cannot determine a project's billing tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Earlier optional benefit AI helpers still use OpenAI. Leave this empty for a
# no-paid-API setup; manual benefit recording remains available.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
