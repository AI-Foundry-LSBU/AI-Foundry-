{
  "name": "ai-foundry-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.21.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:migrate": "node --env-file-if-exists=.env src/db/setup.js migrate",
    "db:seed": "node --env-file-if-exists=.env src/db/setup.js seed",
    "auth:configure": "node src/auth/configure.js",
    "test": "node --env-file-if-exists=.env --test"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "connect-pg-simple": "^10.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "pg": "^8.23.1"
  }
}
